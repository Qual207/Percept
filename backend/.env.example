# Copy this file to .env in the same directory and fill in your values.

# Required: your OpenAI API key (starts with sk-...). Without this the
# backend silently falls back to the deterministic keyword parser, so the
# demo still works — you just don't get the smart agent path.
OPENAI_API_KEY=sk-...

# Optional: which model to use. Must support `response_format: json_schema`
# in strict mode. Cheapest good option is gpt-4o-mini. Other supported:
# gpt-4o, gpt-4o-2024-08-06, gpt-4.1-mini, gpt-4.1.
OPENAI_MODEL=gpt-4o-mini

# Optional: server port (default 3001).
PORT=3001

# Optional: which frontend origin is allowed by CORS. Default matches Vite's
# dev server. Override if you change the frontend port.
ALLOWED_ORIGIN=http://localhost:5173
